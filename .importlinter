[importlinter]
root_package = polymarket_bot

[importlinter:contract:layered]
name = production never imports paper
type = forbidden
source_modules = polymarket_bot._live
forbidden_modules = polymarket_bot._paper

[importlinter:contract:layered2]
# Phase 4 narrowed this: _paper may import _live.feeds (read-only) so the
# paper runtime can subscribe to the same WS upstreams the production bot
# uses. Everything else under _live (runtime, health, storage, and the
# future _live.execution module that lands in Phase 6) stays off-limits.
# This is an allowlist enforced as a denylist of the non-_live.feeds modules.
name = paper never imports live runtime, health, storage, or execution
type = forbidden
source_modules = polymarket_bot._paper
forbidden_modules =
    polymarket_bot._live.runtime
    polymarket_bot._live.health
    polymarket_bot._live.storage
    polymarket_bot._live.execution

[importlinter:contract:layered3]
# Phase 4.5: dashboard is observability only. It reads the decision log
# JSONL + state/feeds_health.json directly. It never instantiates Feeds,
# never runs strategies, never replays the backtest. The pure-dataclass
# types (polymarket_bot.backtest.types) are allowed — they're the schema
# the JSONL log encodes, and _paper.decision_log already depends on them.
# Per design/dashboard.md §3.
name = dashboard never imports live, paper-runtime, backtest-runtime, or strategies
type = forbidden
source_modules = polymarket_bot.dashboard
forbidden_modules =
    polymarket_bot._live
    polymarket_bot._paper.runner
    polymarket_bot._paper.shadow_book
    polymarket_bot.backtest.replay
    polymarket_bot.backtest.runner
    polymarket_bot.backtest.fills
    polymarket_bot.backtest.walk_forward
    polymarket_bot.backtest.side_index
    polymarket_bot.strategies
    polymarket_bot.agents

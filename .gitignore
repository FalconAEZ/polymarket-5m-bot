# Secrets — never commit
.envrc
.envrc.local
*.age
env req.rtf
env*.rtf
secrets.*

# Claude Code: keep project-level settings.json + CLAUDE.md tracked,
# but local overrides stay personal
.claude/settings.local.json
.claude/cache/
.claude/scheduled_tasks.lock
.claude/worktrees/

# Reference repos (mining-only, gitignored)
references/

# Project state (mixed: some files git-tracked, some not).
# Strategy: do NOT exclude state/ wholesale (git docs: "it is not
# possible to re-include a file if a parent directory is excluded").
# Instead, exclude the specific machine-local patterns and let
# everything else be tracked.
state-demo/
state/*.parquet
state/*.log
state/*.err.log
state/*.pid
state/feeds_health.json
state/halt.sentinel
# Obsidian workspace config (machine-specific)
state/.obsidian/
# Phase 5.5+: rsynced mirror of VPS state for local audits
state/staging/
# Phase 5.5+: regeneratable replay output; tracked summary in runbooks/gate-evidence/
state/replay/
# Bonereaper raw trade dumps (26MB-133MB); tracked summary in runbooks/research/
state/research/bonereaper/microstructure-trades*.json
# Bonereaper 195MB joined dump; tracked summary in runbooks/research/
state/research/bonereaper/spot-vs-book-joined-30d.json
# Scout raw dumps + per-candidate trade JSONs; tracked summaries in runbooks/research/
state/research/leaderboard/
# Per locked decision #18 (revised 2026-05-07): vault markdown notes
# (sessions, postmortems, operator runbooks) ARE git-tracked, plus
# Phase 4.5 decision-log JSONL. These ARE NOT excluded above, so they
# get tracked by default. See state/runbooks/decision-18-revision.md.

# Captured market data (Phase 2+)
ticks/

# Database files
trades.db
*.db-shm
*.db-wal

# Python
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Build script byproducts (we keep MASTERPLAN.pdf etc. tracked)
*.pyc

# state/decisions/*.jsonl are runtime data, mutated live by VPS bot.
# They got committed during Phase G analysis (scp'd down for backtest).
# Untrack going forward to prevent VPS pull conflicts.
state/decisions/*.jsonl

[Unit]
Description=Polymarket bot v2 operations dashboard (Streamlit, port 8503)
Documentation=https://github.com/FalconAEZ/polymarket-5m-bot/blob/main/design/dashboard-v2.md
After=network-online.target bot-staging.service
Wants=network-online.target

[Service]
Type=simple
User=ops
Group=ops
WorkingDirectory=/home/ops/polymarket-5m-bot

# uv lives under the ops user's local bin (per Phase 5.2 install).
Environment=PATH=/home/ops/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PMB_DASH_V2=1
Environment=PMB_DASH_STATE_DIR=/home/ops/polymarket-5m-bot/state

ExecStart=/home/ops/.local/bin/uv run --quiet streamlit run scripts/dashboard.py \
    --server.port=8503 \
    --server.address=127.0.0.1 \
    --server.headless=true \
    --server.runOnSave=false \
    --server.fileWatcherType=none \
    --browser.gatherUsageStats=false

# Bind to localhost only — laptop accesses via SSH tunnel; never exposed
# to the public internet.
Restart=on-failure
RestartSec=10s

# Capture output for post-mortem; rotate via existing logrotate.
StandardOutput=append:/home/ops/polymarket-5m-bot/state/streamlit-dashboard.log
StandardError=inherit

# Resource limits — small footprint, plenty for a single-page dashboard.
MemoryMax=512M
CPUQuota=50%

# Hardening (matches bot-staging conventions).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ops/polymarket-5m-bot/state
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
